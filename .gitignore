# ==================================================
# Ignore everything by default
# ==================================================
**

# ==================================================
# Allow directory traversal
# ==================================================
!*/

# ==================================================
# ALWAYS KEEP RENDERED SITE OUTPUT
# ==================================================
!_site/**
!docs/**
!docs/datadictionary/**

# ==================================================
# Keep key top-level files
# ==================================================
!.gitignore
!README.md
!_quarto.yml
!index.qmd
!styles.scss

# ==================================================
# Keep source content
# ==================================================
!data/**
!tables/**
!table/**
!template/**
!scripts/**
!script/**

# ==================================================
# Keep rendered web assets (safety net)
# ==================================================
!**/*.html
!**/*.css
!**/*.js
!**/*.json
!**/*.map
!**/*.svg
!**/*.png
!**/*.jpg
!**/*.jpeg
!**/*.woff
!**/*.woff2
!**/*.ttf
!**/*.wasm
!**/*.yml

# ==================================================
# Ignore Quarto / R / OS junk
# ==================================================
.quarto/
**/*.knit.md
**/*.utf8.md
**/*_cache/
**/cache/
**/.Rhistory
**/.RData
**/.Rproj.user/
**/.Ruserdata
**/.DS_Store
**/Thumbs.db
